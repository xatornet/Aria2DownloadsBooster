<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Textos -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="21" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="#E8ECF8" />
  </Style>
  <Style Selector="TextBlock.subtitle">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="#9AA2BE" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#BAC2DA" />
    <Setter Property="Margin" Value="2,10,0,6" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#6B728A" />
  </Style>
  <Style Selector="TextBlock.meta">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="#7C84A0" />
  </Style>
  <Style Selector="TextBlock.fieldlabel">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="#BAC2DA" />
    <Setter Property="Margin" Value="0,8,0,4" />
  </Style>

  <!-- Tarjetas -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="#181D2E" />
    <Setter Property="BorderBrush" Value="#262D45" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="8,2" />
  </Style>
  <Style Selector="Border.banner">
    <Setter Property="Background" Value="#1C2338" />
    <Setter Property="BorderBrush" Value="#3D4A75" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <!-- Botones -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource AccentGradient}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="#232A44" />
    <Setter Property="Foreground" Value="#C9D0E6" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.iconbtn">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#C9D0E6" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinWidth" Value="38" />
  </Style>
  <Style Selector="Button.iconbtn:pointerover">
    <Setter Property="Background" Value="#2A3252" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="#F87171" />
  </Style>

  <!-- Progreso -->
  <Style Selector="ProgressBar.dl">
    <Setter Property="Height" Value="9" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="#232A42" />
    <Setter Property="Foreground" Value="{DynamicResource AccentGradient}" />
    <Setter Property="MinWidth" Value="120" />
  </Style>

  <!-- Diálogos -->
  <Style Selector="TextBox.urls">
    <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="Height" Value="96" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
</Styles>
