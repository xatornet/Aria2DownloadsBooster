<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:AriaXtr.Services"
        x:Class="AriaXtr.Views.SettingsWindow"
        Title="{x:Static svc:Loc.SettingsTitle}"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#151827" RequestedThemeVariant="Dark">

  <StackPanel Margin="20" Spacing="4">

    <TextBlock Classes="fieldlabel" Text="{x:Static svc:Loc.MaxConcurrent}" />
    <NumericUpDown x:Name="MaxConcurrentBox" Minimum="1" Maximum="20" FormatString="0"
                   Width="140" HorizontalAlignment="Left" />

    <TextBlock Classes="fieldlabel" Text="{x:Static svc:Loc.DefaultConnections}" />
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <Slider x:Name="ConnSlider" Minimum="1" Maximum="16" TickFrequency="1"
              IsSnapToTickEnabled="True" ValueChanged="ConnSlider_OnValueChanged" />
      <TextBlock x:Name="ConnText" Classes="subtitle" VerticalAlignment="Center" MinWidth="24" />
    </Grid>

    <TextBlock Classes="fieldlabel" Text="{x:Static svc:Loc.DefaultFolder}" />
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox x:Name="DirBox" />
      <Button Grid.Column="1" Classes="ghost" Content="{x:Static svc:Loc.Browse}" Click="Browse_Click" />
    </Grid>

    <CheckBox x:Name="TrayBox" Margin="0,14,0,0" Content="{x:Static svc:Loc.TraySetting}" />

    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Classes="ghost" Content="{x:Static svc:Loc.Cancel}" Click="Cancel_Click" />
      <Button Classes="accent" Content="{x:Static svc:Loc.Save}" Click="Save_Click" />
    </StackPanel>

  </StackPanel>
</Window>
