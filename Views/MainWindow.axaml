<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AriaXtr.ViewModels"
        xmlns:svc="clr-namespace:AriaXtr.Services"
        x:Class="AriaXtr.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{x:Static svc:Loc.AppTitle}"
        Width="1040" Height="700" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#12141F"
        RequestedThemeVariant="Dark">

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

    <!-- Cabecera -->
    <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" Padding="22,14,18,14">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
        <StackPanel Spacing="2">
          <TextBlock Classes="title" Text="⚡ Aria2 Downloads Booster" />
          <TextBlock Classes="subtitle" Text="{Binding EngineStatusText}" />
          <TextBlock Classes="subtitle" Text="{Binding LastActionMessage}" Foreground="#FFC96B" />
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="subtitle" Text="{Binding GlobalSpeedText}"
                   FontSize="13" Foreground="#BAC2DA" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="ghost" Content="{x:Static svc:Loc.SettingsBtn}"
                Command="{Binding OpenSettingsCommand}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Barra de herramientas -->
    <Border Grid.Row="1" Padding="20,12,20,8">
      <Button Classes="accent" Content="{x:Static svc:Loc.NewDownload}"
              Command="{Binding AddDownloadCommand}" />
    </Border>

    <!-- Banner del motor aria2 -->
    <Border Grid.Row="2" Classes="banner" Margin="20,2,20,8" Padding="14,12"
            IsVisible="{Binding EngineBannerVisible}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding EngineBannerText}" TextWrapping="Wrap"
                   Foreground="#D5DAEA" FontSize="12" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="accent" Content="{x:Static svc:Loc.InstallEngine}"
                  Command="{Binding InstallEngineCommand}"
                  IsVisible="{Binding InstallButtonVisible}" />
          <ProgressBar Classes="dl" Width="260" Minimum="0" Maximum="100"
                       Value="{Binding InstallProgress}"
                       IsIndeterminate="{Binding InstallIndeterminate}"
                       IsVisible="{Binding EngineInstalling}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Listas -->
    <ScrollViewer Grid.Row="3" Padding="20,0,20,10" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="2">

        <!-- Descargas activas / pausadas -->
        <TextBlock Classes="section" Text="{x:Static svc:Loc.DownloadsLabel}"
                   IsVisible="{Binding HasActive}" />
        <ItemsControl ItemsSource="{Binding Active}" IsVisible="{Binding HasActive}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="svc:DownloadVm">
              <Border Classes="card">
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto"
                      ColumnSpacing="12" RowSpacing="7">

                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                               Foreground="#E8ECF8" TextTrimming="CharacterEllipsis"
                               MaxWidth="480" VerticalAlignment="Center" />
                    <Border Classes="badge" Background="{Binding BadgeBrush}" VerticalAlignment="Center">
                      <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="White" />
                    </Border>
                    <Button Classes="iconbtn" Content="ⓘ" FontSize="12" ToolTip.Tip="{x:Static svc:Loc.Details}"
                            Command="{Binding ToggleDetailCommand}" VerticalAlignment="Center" />
                  </StackPanel>

                  <!-- Botones -->
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
                    <Button Classes="iconbtn" Content="⏸" ToolTip.Tip="{x:Static svc:Loc.Pause}"
                            Command="{Binding PauseCommand}" CommandParameter="{Binding}"
                            IsVisible="{Binding CanPause}" />
                    <Button Classes="iconbtn" Content="▶" ToolTip.Tip="{x:Static svc:Loc.Resume}"
                            Command="{Binding ResumeCommand}" CommandParameter="{Binding}"
                            IsVisible="{Binding CanResume}" />
                    <Button Classes="iconbtn" Content="📁" ToolTip.Tip="{x:Static svc:Loc.OpenFolder}"
                            Command="{Binding OpenFolderCommand}" CommandParameter="{Binding}" />
                    <Button Classes="iconbtn danger" Content="🗑" ToolTip.Tip="{x:Static svc:Loc.Delete}"
                            Command="{Binding DeleteCommand}" CommandParameter="{Binding}" />
                  </StackPanel>

                  <!-- Progreso -->
                  <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <ProgressBar Classes="dl" Value="{Binding Progress}" Minimum="0" Maximum="1" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                      <TextBlock Classes="meta" Text="{Binding ThreadsText}" VerticalAlignment="Center"
                                 Foreground="#9FD8A8" />
                      <TextBlock Classes="meta" Text="{Binding EtaText}" VerticalAlignment="Center" />
                      <TextBlock Classes="meta" Text="{Binding SpeedText}" VerticalAlignment="Center"
                                 Foreground="#8FB8E8" />
                    </StackPanel>
                  </Grid>

                  <!-- Tamaño / acción / error / detalles -->
                  <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <TextBlock Classes="meta" Text="{Binding SizeText}" />
                      <TextBlock Classes="meta" Text="{Binding ActionText}" FontStyle="Italic"
                                 Foreground="#9AA2BE" />
                    </StackPanel>
                    <TextBlock Text="{Binding ErrorText}" FontSize="11" Foreground="#F87171"
                               TextWrapping="Wrap" />
                    <StackPanel IsVisible="{Binding IsDetailVisible}" Spacing="2" Margin="0,6,0,0">
                      <Separator Foreground="#2A3252" />
                      <TextBlock Classes="meta" Text="{x:Static svc:Loc.UrlsCaption}" Margin="0,4,0,0" />
                      <TextBlock Text="{Binding UrlsText}" FontSize="11" Foreground="#9AA2BE"
                                 FontFamily="Consolas, Menlo, monospace" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                        <TextBlock Classes="meta" Text="{x:Static svc:Loc.FolderCaption}" />
                        <TextBlock Classes="meta" Text="{Binding DirText}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="meta" Text="{x:Static svc:Loc.AddedCaption}" />
                        <TextBlock Classes="meta" Text="{Binding AddedText}" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="hint" Text="{x:Static svc:Loc.NoDownloads}" TextAlignment="Center"
                   Margin="0,50,0,0"
                   IsVisible="{Binding !HasActive}" />

        <!-- Completadas -->
        <StackPanel IsVisible="{Binding HasCompleted}">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
            <Button Background="Transparent" BorderThickness="0" Padding="2,0"
                    Click="ToggleCompleted_Click">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock x:Name="CompletedChevron" Text="▼" FontSize="10" Foreground="#9AA2BE" />
                <TextBlock Classes="section" Margin="0" Text="{x:Static svc:Loc.CompletedLabel}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="ghost" Content="{x:Static svc:Loc.CleanupCompleted}"
                    FontSize="11" Padding="10,5" Command="{Binding CleanupCompletedCommand}" />
          </Grid>
          <ItemsControl x:Name="CompletedList" ItemsSource="{Binding Completed}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="svc:DownloadVm">
                <Border Classes="card" Opacity="0.75">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="✅" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                 Foreground="#E8ECF8" TextTrimming="CharacterEllipsis"
                                 MaxWidth="560" VerticalAlignment="Center" />
                      <TextBlock Classes="meta" Text="{Binding SizeText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
                      <Button Classes="iconbtn" Content="📁" ToolTip.Tip="{x:Static svc:Loc.OpenFolder}"
                              Command="{Binding OpenFolderCommand}" CommandParameter="{Binding}" />
                      <Button Classes="iconbtn danger" Content="🗑" ToolTip.Tip="{x:Static svc:Loc.Delete}"
                              Command="{Binding DeleteCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- Pie -->
    <Border Grid.Row="4" Padding="20,8" BorderBrush="#1F2436" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="meta" Text="{Binding FooterText}" />
        <TextBlock Grid.Column="1" Classes="meta" Text="{Binding PollHeartbeatText}" />
      </Grid>
    </Border>

  </Grid>
</Window>
