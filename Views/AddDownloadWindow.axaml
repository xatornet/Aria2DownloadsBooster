<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:AriaXtr.Services"
        x:Class="AriaXtr.Views.AddDownloadWindow"
        Title="{x:Static svc:Loc.AddTitle}"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#151827" RequestedThemeVariant="Dark">

  <StackPanel Margin="20" Spacing="4">

    <TextBlock Classes="fieldlabel" Text="{x:Static svc:Loc.UrlsLabel}" TextWrapping="Wrap" />
    <TextBox x:Name="UrlsBox" Classes="urls" Watermark="{x:Static svc:Loc.UrlsWatermark}"
             KeyDown="UrlsBox_KeyDown" />
    <TextBlock x:Name="ErrorText" Foreground="#F87171" FontSize="11" IsVisible="False" />

    <TextBlock Classes="fieldlabel" Text="{x:Static svc:Loc.FolderLabel}" />
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox x:Name="DirBox" />
      <Button Grid.Column="1" Classes="ghost" Content="{x:Static svc:Loc.Browse}" Click="Browse_Click" />
    </Grid>

    <TextBlock Classes="fieldlabel" Text="{x:Static svc:Loc.FileNameLabel}" />
    <TextBox x:Name="NameBox" Watermark="{x:Static svc:Loc.FileNameWatermark}" />

    <TextBlock Classes="fieldlabel" Text="{x:Static svc:Loc.ConnectionsLabel}" />
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <Slider x:Name="ConnSlider" Minimum="1" Maximum="16" TickFrequency="1"
              IsSnapToTickEnabled="True" ValueChanged="ConnSlider_OnValueChanged" />
      <TextBlock x:Name="ConnText" Classes="subtitle" VerticalAlignment="Center" MinWidth="24" />
    </Grid>

    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Classes="ghost" Content="{x:Static svc:Loc.Cancel}" Click="Cancel_Click" />
      <Button Classes="accent" Content="{x:Static svc:Loc.StartNow}" Click="Download_Click" />
    </StackPanel>

  </StackPanel>
</Window>
