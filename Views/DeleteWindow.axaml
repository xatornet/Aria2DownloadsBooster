<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:AriaXtr.Services"
        x:Class="AriaXtr.Views.DeleteWindow"
        Title="{x:Static svc:Loc.DeleteTitle}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#151827" RequestedThemeVariant="Dark">

  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="{x:Static svc:Loc.DeleteQuestion}" FontSize="13" Foreground="#E8ECF8" />
    <TextBlock x:Name="NameText" Classes="meta" TextWrapping="Wrap" />
    <CheckBox x:Name="DeleteFileCheck" Content="{x:Static svc:Loc.DeleteAlsoFile}"
              Foreground="#C9D0E6" FontSize="12" />
    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Classes="ghost" Content="{x:Static svc:Loc.Cancel}" Click="Cancel_Click" />
      <Button Classes="accent" Background="#7F1D1D" Content="{x:Static svc:Loc.Delete}" Click="Ok_Click" />
    </StackPanel>
  </StackPanel>
</Window>
