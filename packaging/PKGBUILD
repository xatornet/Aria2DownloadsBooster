# Maintainer: XaToR <43992639+xatornet@users.noreply.github.com>
pkgname=aria2-downloads-booster
pkgver=1.0.0
pkgrel=1
pkgdesc="Acelerador de descargas basado en aria2 con interfaz nativa GTK4 (16 hilos, pausa/reanudación persistente)"
arch=('x86_64')
url="https://github.com/xatornet/XTRDownloader"
license=('MIT')
depends=('aria2' 'gtk4' 'libnotify')
makedepends=('rust' 'cargo')
options=('!debug')
# sucesor del paquete homónimo bajo el nombre antiguo (se migra solo el directorio de datos)
conflicts=('aria-xtrdownloader')
replaces=('aria-xtrdownloader')
source=("$pkgname::git+$url.git#branch=arch")
sha256sums=('SKIP')

build() {
  cd "$pkgname"
  cargo build --release --locked
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/aria2-downloads-booster "$pkgdir/usr/bin/aria2-downloads-booster"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 packaging/net.xatornet.aria2downloadsbooster.desktop \
    "$pkgdir/usr/share/applications/net.xatornet.aria2downloadsbooster.desktop"
  install -Dm644 packaging/aria2-downloads-booster.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/aria2-downloads-booster.svg"
}
