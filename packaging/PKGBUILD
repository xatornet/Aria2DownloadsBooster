# Maintainer: XaToR <43992639+xatornet@users.noreply.github.com>
pkgname=aria-xtrdownloader
pkgver=1.0.0
pkgrel=2
pkgdesc="Acelerador de descargas basado en aria2 con interfaz nativa GTK4 (16 hilos, pausa/reanudación persistente)"
arch=('x86_64')
url="https://github.com/xatornet/XTRDownloader"
license=('MIT')
depends=('aria2' 'gtk4' 'libnotify')
makedepends=('rust' 'cargo')
options=('!debug')
source=("$pkgname::git+$url.git#branch=arch")
sha256sums=('SKIP')

build() {
  cd "$pkgname"
  cargo build --release --locked
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/aria-xtrdownloader "$pkgdir/usr/bin/aria-xtrdownloader"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 packaging/io.ariaxtr.downloader.desktop \
    "$pkgdir/usr/share/applications/io.ariaxtr.downloader.desktop"
  install -Dm644 packaging/aria-xtrdownloader.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/aria-xtrdownloader.svg"
}
